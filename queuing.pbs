#!/bin/sh
#PBS -N DataGenMesh
#PBS -l walltime=48:00:00
#PBS -l nodes=CLUSTER_NODE:ppn=8
#PBS -j oe

REPO="${PBS_O_WORKDIR:-$(pwd)}"
ENV="${MESH_ENV:-/mnt/redacted}"
NUM_MESHES="${NUM_MESHES:-1000}"
SCRATCH=/sandbox/${USER}/mesh_${PBS_JOBID}
PERSIST=${REPO}/saved_meshes/run_${PBS_JOBID}

set -e
cd "$REPO"

source "$ENV/bin/activate"
export OSLO_LOCK_PATH=~/tmp
export FOAM_SIGFPE=false
export MESH_SCRATCH="$SCRATCH"

mkdir -p "$SCRATCH"

# copy results back + clean scratch on any exit
cleanup() {
    if [ -d "$SCRATCH/saved_meshes" ]; then
        mkdir -p "$PERSIST"
        cp "$SCRATCH"/saved_meshes/*.pt "$PERSIST"/ 2>/dev/null || true
    fi
    rm -rf "$SCRATCH"
}
trap cleanup EXIT

python data_generator.py -n "$NUM_MESHES" > "$REPO/output_mars.log" 2>&1

deactivate
